+           r.max_sum,
+           count( b.* )
+      FROM bookings b
+      RIGHT OUTER JOIN ranges r
+        ON  b.total_amount >= r.min_sum
+        AND b.total_amount <  r.max_sum
+      GROUP BY r.min_sum, r.max_sum
