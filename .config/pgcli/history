+create table artists (
+	id serial primary key,
+	name text not null,
+	created_at timestamp default current_timestamp,
+	check (trim(name) <> '')
+);
+
+create table artist_members (
+	id serial primary key,
+	artist int references artists(id),
+	name text,
+	created_at timestamp default current_timestamp,
+	check (trim(name) <> '')
+);
+
